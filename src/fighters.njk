{%- set supporters = fightersAll | selectattr("supporter") | list %}
<div class="kicker"><a href="/">Follow the Money</a> · directory</div>
<h1>Pro-Democracy <em>Fighters</em></h1>
<div class="standfirst">The commentators, analysts, strategists, organizers, and organizations doing the work — {{ fightersAll | length }} of them, grouped by what they actually do.</div>
{%- if supporters | length %}
<div class="fgt-legend"><span class="fgt-badge">✊ We support</span> marks the {{ supporters | length }} we put our own money behind — a subscription, a membership, or a donation. Everyone here is worth your attention; these are the ones we back.</div>
{%- endif %}
<div class="hub-tagline">Know someone who belongs here? Tell us: contact@moralfibermedia.com</div>

{%- for group in fightersByCategory %}
<h2 class="fgt-cat">{{ group.name }} <span class="fgt-cat-n">{{ group.items | length }}</span></h2>
<div class="fighters">
{%- for f in group.items %}
  <a class="fgt{% if f.supporter %} is-supported{% endif %}" href="{{ f.url }}" target="_blank" rel="noopener">
    <span class="fgt-i">✊</span>
    <span><span class="fgt-n">{{ f.name }}</span>{% if f.supporter %}<span class="fgt-badge">✊ We support</span>{% endif %}<br><span class="fgt-d">{{ f.description }}</span><br><span class="ins-u">{{ f.display_url }}</span></span>
  </a>
{%- endfor %}
</div>
{%- endfor %}

