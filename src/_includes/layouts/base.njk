<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="google-site-verification" content="WAtQj020-z9bFWKH7NsnCvpEt_bW_oRj02z1W6F-lFw">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

{%- set canonSlug = canonicalPath -%}
{%- if canonSlug.slice(-1) != "/" -%}{%- set canonSlug = canonSlug + "/" -%}{%- endif -%}
{%- set canonUrl = site.base + canonSlug -%}
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ canonUrl }}">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ canonUrl }}">
<meta property="og:image" content="{{ site.base }}{{ ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ site.base }}{{ ogImage }}">

<title>{{ pageTitle }}</title>
{% if jsonld %}<script type="application/ld+json">{{ jsonld | safe }}</script>{% endif %}
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,900&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/site.css">
<script>try{if(localStorage.getItem("ftm-shimmer")==="disco")document.documentElement.classList.add("disco")}catch(e){}</script>
{% if extraHead %}{{ extraHead | safe }}
{% endif %}</head>
<body>
<header class="site-band">
  <a class="band-brand" href="/">
    <img src="/assets/mfm-mark.png" alt="" width="34" height="34">
    <span>Follow the <em>Money</em></span>
  </a>
  <nav class="band-nav">
    <div class="nav-item">
      <button class="nav-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="navMenu">Puzzles <span class="caret">▾</span></button>
      {% include "nav-menu.njk" %}
    </div>
    <a class="nav-link nav-hot" href="/dream-ticket/">★ 2028 Ticket</a>
    <a class="nav-link" href="/fighters">Fighters</a>
    <a class="nav-link" href="https://moralfibermedia.com" target="_blank" rel="noopener">Substack</a>
  </nav>
</header>
<div class="article">
{% if pageScript %}
<div class="page-grid">
<div class="page-main">
{{ content | safe }}
</div>
{% include "rail.njk" %}
</div>
{% else %}
{{ content | safe }}
{% endif %}
{% include "tail.njk" %}
</div>
{% if pageScript %}<div class="focus-scrim" aria-hidden="true"></div>
<script src="{{ pageScript }}"></script>
<script src="/assets/puzzle-result.js"></script>{% endif %}
<script>
(function(){
  var trig=document.querySelector(".nav-trigger"),menu=document.getElementById("navMenu");
  if(!trig||!menu)return;
  function close(){menu.classList.remove("open");trig.setAttribute("aria-expanded","false");}
  trig.addEventListener("click",function(e){e.stopPropagation();var o=menu.classList.toggle("open");trig.setAttribute("aria-expanded",o?"true":"false");});
  document.addEventListener("click",function(e){if(menu.classList.contains("open")&&!menu.contains(e.target)&&!trig.contains(e.target))close();});
  document.addEventListener("keydown",function(e){if(e.key==="Escape")close();});
})();
</script>
</body>
</html>
